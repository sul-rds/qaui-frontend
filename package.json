{
	"name": "qaui-ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"typegen": "pocketbase-typegen --db ../pb/pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^25.5.0",
		"@vitest/browser": "^4.1.2",
		"carbon-components-svelte": "^0.105.0",
		"carbon-icons-svelte": "^13.10.0",
		"carbon-preprocess-svelte": "^0.11.29",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"playwright": "^1.58.2",
		"pocketbase": "^0.26.8",
		"pocketbase-typegen": "^1.3.3",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.5",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^2.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sqlite3"
		]
	},
	"dependencies": {
		"@fontsource-variable/mulish": "^5.2.8",
		"tippy.js": "^6.3.7"
	}
}
